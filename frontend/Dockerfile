# Builds the Vite bundle and serves it from nginx, which also takes over the
# role the Vite dev proxy plays locally: routing /api/* to the right service.

# Node 24 / npm 11: package-lock.json was generated by npm 11, and npm 10 in the
# node:20 image resolves the dependency graph differently (npm ci then fails).
FROM node:24-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# `npm run build` also runs tsc -b; the image only needs the bundle.
RUN npm run build:docker


FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/api-proxy.conf /etc/nginx/api-proxy.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
