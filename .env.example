# --- Яндекс ID (OAuth2) ------------------------------------------------------
# Создать приложение: https://oauth.yandex.ru/client/new
# Redirect URI: http://localhost:8082/login/oauth2/code/yandex
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# --- Почта для уведомлений (SMTP) --------------------------------------------
# Для Gmail нужен пароль приложения, а не пароль аккаунта:
# https://myaccount.google.com/apppasswords
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# --- Ключи приложения --------------------------------------------------------
# Значения по умолчанию годятся только для локального запуска. Для любого
# развёртывания за пределами своей машины задайте свои.
#
# ВНИМАНИЕ: CRYPTO_SECRET_KEY шифрует данные в БД. Если поменять его на уже
# заполненной базе, ранее сохранённые данные не расшифруются.
#
# JWT_ACCESS_SECRET=
# INTERNAL_SYSTEM_TOKEN=
# CRYPTO_SECRET_KEY=

# --- MinIO -------------------------------------------------------------------
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
